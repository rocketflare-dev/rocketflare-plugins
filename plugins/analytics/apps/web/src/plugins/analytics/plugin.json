{
  "id": "analytics",
  "label": "Analytics",
  "version": "1.0.2",
  "repo": "https://github.com/rocketflare-dev/rocketflare-plugins.git",
  "anchor": "apps/web/src/plugins/analytics/plugin.json",
  "paths": [
    "apps/web/src/plugins/analytics/**",
    "packages/shared/src/plugins/analytics/**",
    "apps/cli/src/plugins/analytics/**"
  ],
  "registries": [
    "apps/web/src/plugins/server.ts",
    "apps/web/src/plugins/ui.ts",
    "apps/web/src/plugins/schema.ts",
    "packages/shared/src/plugins/index.ts",
    "apps/cli/src/plugins/index.ts"
  ],
  "requires": {
    "kit": ">=0.7.0 <1.0.0",
    "pluginApi": "1",
    "surfaces": [],
    "plugins": []
  },
  "dependencies": {
    "apps/web": {
      "d3": "^7.9.0",
      "drizzle-cube": "0.8.3",
      "react-grid-layout": "^2.2.4",
      "react-is": "^19.3.0",
      "recharts": "^3.10.1"
    },
    "packages/shared": {},
    "apps/cli": {}
  },
  "bindings": [],
  "crons": ["15 * * * *"],
  "apiPrefixes": ["/cubejs-api", "/mcp"],
  "coreEdits": [
    {
      "file": "apps/web/vite.config.ts",
      "after": "'/ws': proxyTo(",
      "lines": ["'/cubejs-api': proxyTo(),", "'/mcp': proxyTo(),"]
    },
    {
      "file": "apps/web/vite.config.ts",
      "after": "'@': path.resolve(",
      "lines": [
        "'@nivo/heatmap': path.resolve(__dirname, './src/plugins/analytics/ui/lib/nivo-heatmap.tsx'),"
      ]
    }
  ],
  "vars": [],
  "workerExports": [],
  "schema": {
    "tables": ["analytics_pages", "analytics_page_groups", "analytics_tenant_activity_daily_facts"],
    "rlsExcluded": []
  },
  "migrations": [
    "analytics_pages \u2014 one dashboard per row, tenant-scoped, jsonb config, RLS policy",
    "analytics_page_groups \u2014 which groups a `visibility: 'groups'` dashboard is shared with",
    "analytics_tenant_activity_daily_facts \u2014 activity pre-aggregated to (tenant, day, user), UNIQUE NULLS NOT DISTINCT, RLS policy"
  ],
  "subdir": "plugins/analytics"
}
