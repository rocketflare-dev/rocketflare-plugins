{
  "id": "freeagent",
  "label": "FreeAgent",
  "version": "3.6.0",
  "repo": "https://github.com/rocketflare-dev/rocketflare-plugins.git",
  "minKit": "0.21.0",
  "anchor": "apps/web/src/plugins/freeagent/plugin.json",
  "paths": [
    "apps/web/src/plugins/freeagent/**",
    "packages/shared/src/plugins/freeagent/**",
    "apps/cli/src/plugins/freeagent/**",
    "docs/plugins/freeagent/**"
  ],
  "registries": [
    "apps/web/src/plugins/server.ts",
    "apps/web/src/plugins/ui.ts",
    "apps/web/src/plugins/schema.ts",
    "packages/shared/src/plugins/index.ts",
    "apps/cli/src/plugins/index.ts"
  ],
  "requires": {
    "surfaces": [],
    "plugins": []
  },
  "uses": {
    "@/plugins/api": [
      "createRouter",
      "cronCtx",
      "CronCtx",
      "Database",
      "defineTool",
      "jobCtx",
      "JobCtx",
      "JobHandler",
      "JobInput",
      "openSecret",
      "PluginConfig",
      "publicCtx",
      "PublicCtx",
      "recordActivity",
      "requestCtx",
      "RequestCtx",
      "ScheduledTask",
      "sealSecret",
      "ServerPlugin",
      "signState",
      "Tool",
      "toolCtx",
      "ToolCtx",
      "validate",
      "verifyState"
    ],
    "@/plugins/api/peers": [
      "extensions"
    ],
    "@/plugins/api/ui-wiring": [
      "NavGuard",
      "UiPlugin"
    ],
    "@/plugins/api/ui": [
      "api",
      "ApiError",
      "ConfirmModal",
      "EmptyState",
      "formatDateTime",
      "PageHeader",
      "PaginationControls",
      "SectionPanel",
      "SectionPanelSkeleton",
      "SettingRow",
      "showToast",
      "SkeletonRows",
      "timeAgo",
      "usePermissions"
    ],
    "@/db/schema/kit": [
      "tenantIsolation",
      "tenantRef",
      "tenants",
      "timestamps",
      "users"
    ],
    "'../api' (apps/cli/src/plugins/api.ts)": [
      "CliPlugin",
      "CommandContext",
      "formatDate",
      "requireClient"
    ],
    "@testkit/integration": [
      "createExecutionContext",
      "createTestEnv",
      "createTestSession",
      "createTestTenant",
      "createTestUser",
      "dispatchScheduled",
      "json",
      "linkUserToTenant",
      "request",
      "sessionCookieHeader",
      "setupTestDatabase",
      "stubs",
      "TestEnv",
      "waitOnExecutionContext"
    ],
    "@testkit/unit": [
      "makeCronCtx",
      "makeJobCtx",
      "makeToolCtx"
    ],
    "@rocketflare/shared/jobs": [
      "JobOf"
    ],
    "@rocketflare/shared/pagination": [
      "paginatedResponse",
      "paginationQuerySchema"
    ],
    "@rocketflare/shared/plugins/types": [
      "SharedPlugin"
    ]
  },
  "dependencies": {
    "apps/web": {},
    "packages/shared": {},
    "apps/cli": {}
  },
  "bindings": [],
  "crons": [
    "*/30 * * * *"
  ],
  "apiPrefixes": [],
  "coreEdits": [],
  "vars": [
    {
      "key": "FREEAGENT_CLIENT_ID",
      "secret": true
    },
    {
      "key": "FREEAGENT_CLIENT_SECRET",
      "secret": true
    },
    {
      "key": "FREEAGENT_ENVIRONMENT",
      "example": "sandbox",
      "secret": true
    }
  ],
  "workerExports": [],
  "skills": [
    "freeagent"
  ],
  "schema": {
    "tables": [
      "freeagent_connections",
      "freeagent_sync_state",
      "freeagent_bank_accounts",
      "freeagent_bank_transactions",
      "freeagent_explanations",
      "freeagent_categories",
      "freeagent_contacts",
      "freeagent_bills",
      "freeagent_invoices"
    ],
    "rlsExcluded": []
  },
  "migrations": [
    "freeagent_connections — one row per tenant (unique tenant_id): environment, status, sealed refresh/access tokens, company, sync claim and last outcome; RLS policy",
    "freeagent_sync_state — one updated_since cursor per (tenant, resource), unique; RLS policy",
    "freeagent_bank_accounts / freeagent_bank_transactions / freeagent_explanations / freeagent_categories / freeagent_contacts / freeagent_bills / freeagent_invoices — the mirror, each unique on (tenant_id, url), money as numeric; RLS policies"
  ],
  "subdir": "plugins/freeagent"
}
